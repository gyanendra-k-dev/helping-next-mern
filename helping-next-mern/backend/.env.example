# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of this API (used to build upload URLs). Leave blank to auto-detect.
APP_URL=http://localhost:5000

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/helping_next
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helping_next
MONGODB_URI=mongodb://127.0.0.1:27017/helping_next

# ---------- Auth ----------
# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------- CORS / Frontend ----------
# React app URL(s), comma separated. Password-reset emails link here.
FRONTEND_URL=http://localhost:5173

# ---------- Razorpay (test keys: https://dashboard.razorpay.com/app/keys) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (password reset) ----------
# If SMTP_HOST is empty, the reset link is printed in the server console (like Laravel's MAIL_MAILER=log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Helping Next
